{
  "cleanUrls": true,
  "crons": [
    { "path": "/api/sim-sync", "schedule": "0 5 * * *" }
  ],
  "functions": {
    "api/sim-sync.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
