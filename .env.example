# Supabase project (Settings -> API). The anon key is browser-safe under RLS.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# Server-only — NEVER expose in the browser or commit. Used by the SIM sync job.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 1oT Terminal SIM API (https://api.1ot.mobi/v1)
ONEOT_CLIENT_ID=
ONEOT_CLIENT_SECRET=

# WhatsApp Business API provider (e.g. Twilio / 360dialog)
WHATSAPP_API_TOKEN=
WHATSAPP_FROM=
